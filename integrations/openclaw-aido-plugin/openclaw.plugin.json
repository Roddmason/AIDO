{
  "id": "aido-control",
  "name": "AIDO Control",
  "description": "Inspect and control your AIDO Local Control Center projects.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "AIDO base URL (loopback).",
        "default": "http://127.0.0.1:4310"
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "aido_overview",
      "aido_list_projects",
      "aido_list_templates",
      "aido_create_project",
      "aido_list_threads",
      "aido_create_thread",
      "aido_send_message",
      "aido_thread_status",
      "aido_execution_status",
      "aido_worker_status",
      "aido_worker_resume"
    ]
  }
}
