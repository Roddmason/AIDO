# Safety defaults
AIDO_DEFAULT_ROUTING_MODE=balanced_best_value
AIDO_ENABLE_REAL_PROVIDER_CALLS=false
AIDO_ENABLE_CLI_RUNTIMES=false
AIDO_MAX_COST_PER_TASK_USD=2.00
AIDO_REDACT_SECRETS=true

# External secrets provider, preferred for real API keys.
# Store provider credential refs as openbao:secret/providers/nvidia_nim#api_key.
AIDO_SECRET_VAULT_ADDR=
# token or approle. Prefer approle for real deployments.
AIDO_SECRET_VAULT_AUTH_METHOD=token
AIDO_SECRET_VAULT_APPROLE_PATH=auth/approle
AIDO_SECRET_VAULT_ROLE_ID_REF=
AIDO_SECRET_VAULT_SECRET_ID_REF=
# Token refs are acceptable for bootstrap/dev only; prefer AppRole for real use.
AIDO_SECRET_VAULT_TOKEN_REF=
# Dev/bootstrap fallback only.
AIDO_SECRET_VAULT_TOKEN=
AIDO_ALLOW_INSECURE_LOCAL_VAULT=false
OPENBAO_ADDR=
# Dev/bootstrap fallback only.
OPENBAO_TOKEN=
VAULT_ADDR=
# Dev/bootstrap fallback only.
VAULT_TOKEN=

# API provider env refs are for quick local development only.
# Prefer OpenBao/Vault-compatible refs for long-lived real provider keys.
NVIDIA_NIM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional local/gateway providers
OLLAMA_BASE_URL=http://localhost:11434
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Runtime detection
CODEX_CLI_PATH=codex
CLAUDE_CODE_CLI_PATH=claude
OPENHANDS_CLI_PATH=openhands
SWE_AGENT_CLI_PATH=sweagent

# Local Control Center
LOCAL_CONTROL_CENTER_DB=
LOCAL_CONTROL_CENTER_CWD=

# Legacy or optional integrations
GEMINI_API_KEY=
GOOGLE_API_KEY=
N8N_BASE_URL=http://localhost:15678
N8N_API_URL=http://localhost:15678/api/v1
N8N_WEBHOOK_URL=
N8N_EDITOR_BASE_URL=http://localhost:15678
OLLAMA_HOST=http://127.0.0.1:11434
IA_AGENT_N8N_PORT=15678
IA_AGENT_OLLAMA_PORT=21434
IA_AGENT_CONTROL_CENTER_PORT=4310
TZ=America/Santiago
